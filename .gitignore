__pycache__/
*.pyc
.env
.venv/
venv/
.DS_Store
# Ignore the data tree, but TRACK the hand-curated Damodaran reference tables
# (the live engines depend on them — a fresh clone must not silently fall back).
# Git can only re-include a file if its parent dirs are re-included first.
valuation_data/*
!valuation_data/macro/
valuation_data/macro/*
!valuation_data/macro/damodaran_implied_erp.csv
!valuation_data/macro/damodaran_industry_betas.csv
!valuation_data/macro/damodaran_sector_cost_of_capital.csv

*.txt
!requirements.txt
*.zip
*.log
*.jsonl
tag_miss_audit_results.json

# Runtime audit/trace output (traces, guard logs, gate artifacts) — regenerable,
# large (100s of MB). Never versioned. See archive/README for rationale.
audits/
# Generated PDF reports (rendered on demand).
*.pdf
# Editor/Finder duplicate artifacts ("foo 2.py").
* 2.*

# Terraform (deploy/terraform) — never commit state or secret-bearing tfvars
**/.terraform/
*.tfstate
*.tfstate.*
deploy/terraform/terraform.tfvars
crash.log
