# Aletheia environment configuration — copy to `.env` and fill in.
# `.env` is gitignored; this template is committed as documentation.

# ── Core (required for full pipeline) ────────────────────────────────
# Google Gemini — powers the Stage-4 narrative agents (thesis,
# contrarian, qualitative synthesis) and the LLM extractors.
GOOGLE_API_KEY=
# Optional override of the Gemini model id used by the agents.
LLM_MODEL=

# SEC EDGAR requires a declared identity string ("Name email") on every
# request. Used by the librarian / XBRL ingestion.
SEC_IDENTITY=

# Financial Modeling Prep — core financials data source.
FMP_API_KEY=

# Guard mode for the calc layer (see aletheia guard docs). Optional.
ALETHEIA_GUARD_MODE=

# ── Observability: LangSmith tracing (optional) ──────────────────────
# When LANGSMITH_API_KEY is set, the Stage-4 LangGraph agents are traced
# to LangSmith (per-node spans, token cost, latency), filterable by
# ticker. Leave blank to keep tracing OFF — the pipeline runs identically
# without it (see aletheia/eval/tracing.py).
#
# Get a key at https://smith.langchain.com/ (Settings → API Keys).
LANGSMITH_API_KEY=
# Project name shown in the LangSmith UI. Defaults to "aletheia".
LANGSMITH_PROJECT=aletheia
# Explicit on/off. Auto-enabled when a key is present; set to "false" to
# keep tracing off even with a key configured.
LANGSMITH_TRACING=true

# ── Observability: LLM judge (optional, Workstream 2 — not yet wired) ─
# Anthropic Claude grades the LLM outputs (cross-family, avoids Gemini
# self-grading bias). Required only to run the LLM-judge harness.
ANTHROPIC_API_KEY=
